# ══════════════════════════════════════════════════════════════
# SmartWMS — Environment Variables Template
# ══════════════════════════════════════════════════════════════

# ─── Database ──────────────────────────────────────────────

# Option A: Local development (SQLite — no server required)
DATABASE_URL="file:./prisma/dev.db"

# Option B: Docker Compose (PostgreSQL)
# POSTGRES_PASSWORD=wms_secure_2024
# DATABASE_URL=postgresql://wms_admin:wms_secure_2024@localhost:5432/warehouse_management

# Option C: Supabase (production cloud)
# DATABASE_URL=postgresql://postgres:<PASSWORD>@<HOST>:6543/postgres?sslmode=require

# ─── JWT Authentication ─────────────────────────────────────
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRATION=24h

# ─── AI Service ─────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000

# ─── Backend ────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# CORS origin (defaults to http://localhost:3000 if unset)
# CORS_ORIGIN=http://localhost:3000

# ─── Frontend ───────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:3001
